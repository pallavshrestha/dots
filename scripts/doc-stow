# doc-stow
# A script to move pdfs from current directory and move it to a document vault,
# and created symlink in the current directory. Checks for duplicates in the
# vault and skips

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: doc-stow [-f] [-r] [-c] [-h]

Moves *.pdf from the current directory into the document vault and creates symlinks
back into the current directory.

Options:
  -h    Show this help and exit. Also shown on errors.
  -f    Also process files that are already in the vault:
          - If the current document already exist in the docvault
              remove it from the current directory (if present and not the vault copy),
              then create a symlink in the current directory pointing to the vault copy.
  -r    Runs magic rename before processing
  -c    Query Crossref and rename PDFs to author_year before processing.
        Requires internet access and adds runtime.

Notes:
  - By default (no -f):
      1) Reminds to run pdf2bib and magic_rename in the current directory (with confirmation).
      2) Moves PDFs from current directory into the vault and creates symlinks back.
      3) Skips any PDF whose target already exists in the vault.
EOF
}

on_error() {
  echo "Error: $*" >&2
  echo >&2
  usage
  exit 1
}

f_flag=0
c_flag=0
r_flag=0

while getopts ":frch" opt; do
  case "$opt" in
    f) f_flag=1 ;;
    r) r_flag=1 ;;
    c) c_flag=1 ;;
    h) usage; exit 0 ;;
    *) on_error "Invalid option: -$OPTARG" ;;
  esac
done
shift $((OPTIND - 1))

if [[ "$f_flag" -eq 0 ]]; then
  echo "Please run pdf2bib and magic_rename in the current directory before running this script"
  echo "Type yes to confirm:"
  read -r ans
  [[ "$ans" == "yes" ]] || exit 0
fi

docvault="$HOME/work/docVault"
mkdir -p "$docvault"

# --- Helpers --- # 

create_symlink() {
  local target="$1"   # absolute path in vault
  local linkpath="$2" # link path in current dir

  if [[ -e "$linkpath" || -L "$linkpath" ]]; then
    echo "A file or symlink already exists at: $linkpath"
    echo "Skipping..."
    echo
    return 0
  fi

  ln -s -- "$target" "$linkpath"
  echo "Symlink established: $linkpath"
  echo
}


# --- -r flag (rename using crossref) --- #
if [[ "$r_flag" -eq 1 ]]; then
    magic_rename
fi

# --- -c flag (rename using crossref) --- #
if [[ "$c_flag" -eq 1 ]]; then
    pdf2bib
fi

# --- main logic --- #
    
shopt -s nullglob

# defualt behaviour
for f in *.pdf; do # don't process symlink
    if [[ -L "$f" ]]; then
        continue
    fi

    current_file="$f"
    base_name="$(basename -- "$current_file")"
    target="$docvault/$base_name"

    echo "Processing $current_file"

    if [[ -e "$target" || -L "$target" ]]; then
        if [[ "$f_flag" -eq 1 ]]; then
            rm "$current_file"
            ln -s -- "$target" "$current_file"
            echo "Symlink established: $current_file"
            echo
            continue
        else
            echo "Document already in vault: $base_name"
            echo "Skipping..."
            echo
            continue
        fi
    fi

    mv -- "$current_file" "$target"
    echo "Document moved to: $target"

    # linkpath now equals the old filename
    if [[ -e "$current_file" || -L "$current_file" ]]; then
      echo "A file or symlink already exists at $current_file."
      echo "Skipping ..."
      echo
      continue
    fi

    ln -s -- "$target" "$current_file"
    echo "Symlink established: $current_file"
    echo
done

