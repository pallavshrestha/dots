set font			"JetBrains Mono Nerd Font 10"
set default-fg 			"#eceff4"  # nord6, white-ish
set default-bg 			"rgba(46,52,64,0.5)"  #2e3440" # nord0, darkest

set guioptions none

# set completion-bg		"#3b4252"
set completion-bg		"#2e3440"
set completion-fg		"#eceff4"
set completion-highlight-bg	"#4c566a"
set completion-highlight-fg	"#eceff4"
set completion-group-bg		"#3b4252"
set completion-group-fg		"#88c0d0" # nord8

set statusbar-fg		"#2e3440" #"#eceff4" # "#2e3440"
set statusbar-bg		"#8fbcbb"
set statusbar-h-padding		5
set statusbar-v-padding		5
set statusbar-home-tilde "true"
# set statusbar-basename "true"

set notification-bg		"#2e3440"
set notification-fg		"#eceff4"
set notification-error-bg	"#2e3440"
set notification-error-fg	"#bf616a"
set notification-warning-bg	"#2e3440"
set notification-warning-fg	"#ebcb8b"
set selection-notification	"true"

set inputbar-fg			"#eceff4"
set inputbar-bg 		"#434c5e"
#set inputbar-bg 		"#3b4252"

set recolor			"true"


# amber on dark slate
map ! feedkeys ":set recolor-lightcolor \#0a0a12<Return>:set recolor-darkcolor \#ff9900<Return>"

map @ feedkeys ":set recolor-lightcolor \#002b36<Return>:set recolor-darkcolor \#839496<Return>"


# Nord dark recolor
map \# feedkeys ":set recolor-lightcolor rgba(59,66,82,0.7)<Return>:set recolor-darkcolor \#ffffff<Return>"
set recolor-lightcolor		"rgba(59,66,82,0.5)"
set recolor-darkcolor		"#ffffff"

# Mayberry 
map \$ feedkeys ":set recolor-lightcolor \#f6f1ea<Return>:set recolor-darkcolor \#8a5a2b<Return>"


# nord polar light recolor
map \% feedkeys ":set recolor-lightcolor \#eceff4<Return>:set recolor-darkcolor \#4c566a<Return>"

# solarized light recolor
map \^ feedkeys ":set recolor-lightcolor \#eee7d5<Return>:set recolor-darkcolor \#4e4e4e<Return>"


#gruvbox light recolor
map \& feedkeys ":set recolor-lightcolor \#fbf1c7<Return>:set recolor-darkcolor \#3c3836<Return>"
# set recolor-lightcolor          "#fbf1c7" # bg
# set recolor-darkcolor           "#3c3836" # fg


# set index-fg			"#eceff4"
# set index-bg			"#2e3440"
# set index-active-fg		"#eceff4"
# set index-active-bg		"#4c566a"
# set sandbox none #these don't exist anymore

set render-loading-bg		"#2e3440"
set render-loading-fg		"#eceff4"

# set highlight-color		"#88c0d0"
set highlight-color		"rgba(136,192,208,0.5)"
set highlight-active-color	"rgba(236,239,244,0.5)"  #ebcbb8

set adjust-open			"width"

set selection-clipboard clipboard
set recolor-keephue

#set pages-per-row 2

# for inversesearch
set synctex true
# set synctex-editor-command "vim --remote-silent +%{line} %{input}"
set synctex-editor-command "vim -v --not-a-term -T dumb -c \"VimtexInverseSearch %{line}:%{column} '%{input}'\""
